# General Environment Configuration
NODE_ENV=development
PORT=4000
WEB_PORT=3000
PYTHON_AGENT_PORT=8000

# Database Configuration (PostgreSQL + Prisma Role Separation)
POSTGRES_USER=bridge_admin
POSTGRES_PASSWORD=YOUR_LOCAL_POSTGRES_PASSWORD
POSTGRES_DB=bridge_ai_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Role Purposes:
# - RUNTIME_DATABASE_URL: Used by API runtime (bridge_ai_runtime role). DML only on application tables. No DDL or _prisma_migrations access.
# - MIGRATION_DATABASE_URL: Used by one-shot api-migrate container (bridge_ai_migrator role). Owns application schema & executes npx prisma migrate deploy.
# - TEST_DATABASE_URL: Used by automated test suite (bridge_ai_test_runner role). Isolated to bridge_ai_test_db.
# - bridge_admin: Superuser break-glass recovery role. Omitted from API runtime and migration containers.
RUNTIME_DATABASE_URL="postgresql://bridge_ai_runtime:YOUR_RUNTIME_PASSWORD@postgres:5432/bridge_ai_db?schema=public"
MIGRATION_DATABASE_URL="postgresql://bridge_ai_migrator:YOUR_MIGRATION_PASSWORD@postgres:5432/bridge_ai_db?schema=public"
TEST_DATABASE_URL="postgresql://bridge_ai_test_runner:YOUR_LOCAL_TEST_POSTGRES_PASSWORD@localhost:5432/bridge_ai_test_db?schema=public"

# Python Funding Agent Service URL
FUNDING_AGENT_URL="http://localhost:8000"

# Grants.gov Integration Configuration
GRANTS_GOV_API_BASE_URL="https://api.grants.gov"
GRANTS_GOV_REQUEST_TIMEOUT_MS=15000

# Human Review Authorization Token
BRIDGE_REVIEW_TOKEN="replace-with-a-long-random-local-review-token"


# Application Flags
HUMAN_IN_THE_LOOP_ENFORCED=true
AUTONOMOUS_SUBMISSION_ENABLED=false

# AI Funding Analyst Configuration (AI-1)
AI_FUNDING_ANALYST_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_OUTPUT_TOKENS=2500
AI_EVALUATION_RATE_LIMIT_PER_HOUR=5

# Official Notice Ingestion Configuration (AI-2A)
DOCUMENT_INGESTION_ENABLED=false
DOCUMENT_STORAGE_ROOT=/data/funding-documents
DOCUMENT_MAX_FILE_BYTES=26214400
DOCUMENT_MAX_PAGES=300
DOCUMENT_EXTRACTION_TIMEOUT_MS=30000
DOCUMENT_EXTRACTION_VERSION=pdf-page-text-v1

# Document-Grounded Retrieval Configuration (AI-2B)
AI_DOCUMENT_GROUNDING_ENABLED=false
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_EMBEDDING_TIMEOUT_MS=30000
DOCUMENT_EMBEDDING_BATCH_SIZE=32
DOCUMENT_CHUNK_TARGET_TOKENS=500
DOCUMENT_CHUNK_OVERLAP_TOKENS=75
DOCUMENT_RETRIEVAL_TOP_K=8
DOCUMENT_RETRIEVAL_MAX_CONTEXT_TOKENS=6000

