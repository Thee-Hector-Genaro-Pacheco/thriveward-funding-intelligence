{
  "name": "thriveward-funding-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "Human-led funding, readiness, and partnership intelligence platform for Project Thriveward",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:auth:bootstrap": "npm run dev:auth:bootstrap --workspace=apps/api",
    "dev:auth:inspect": "npm run dev:auth:inspect --workspace=apps/api",
    "dev:grounded:evaluate": "npm run dev:grounded:evaluate --workspace=apps/api --",
    "dev:org:bootstrap": "npm run dev:org:bootstrap --workspace=apps/api",
    "dev:org:inspect": "npm run dev:org:inspect --workspace=apps/api",
    "dev:document:ingest": "npm run dev:document:ingest --workspace=apps/api --",
    "dev:document:index": "npm run dev:document:index --workspace=apps/api --",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run prisma:generate --workspace=apps/api",
    "db:push": "npm run prisma:push --workspace=apps/api"
  },
  "keywords": [
    "thriveward",
    "funding-intelligence",
    "reentry",
    "nonprofit-operations"
  ],
  "author": "Project Thriveward",
  "license": "UNLICENSED"
}
