generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EligibilityStatus {
  HIGH_PRIORITY
  INVESTIGATE
  FUTURE_OPPORTUNITY
  NOT_ELIGIBLE
}

enum TriStateStatus {
  YES
  NO
  CONDITIONAL
  UNKNOWN
}

enum OpportunityStatus {
  EXTRACTED
  PENDING_HUMAN_REVIEW
  VERIFIED
  ARCHIVED
}

enum RelevanceStatus {
  STRONGLY_RELEVANT
  RELEVANT
  POSSIBLY_RELEVANT
  IRRELEVANT
  UNKNOWN
}

enum PursuitStage {
  NEW
  REVIEWING
  QUALIFIED
  LOCKED
  DISMISSED
}

enum CandidateRoutingStatus {
  DIRECT_FEDERAL_ELIGIBLE
  FISCAL_SPONSOR_REQUIRED
  PARTNERSHIP_REQUIRED
  FUTURE_OPPORTUNITY
  EXCLUDED
}

model OrganizationProfile {
  id                 String   @id @default(uuid())
  name               String   @default("Project Thriveward")
  status             String   @default("PRE_INCORPORATION")
  taxStatus          String   @default("NOT_OBTAINED")
  primaryPopulations String[]
  primaryOutcome     String
  coreModel          String
  limitations        String[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  programs Program[]
}

model Program {
  id                    String              @id @default(uuid())
  organizationProfileId String
  organizationProfile   OrganizationProfile @relation(fields: [organizationProfileId], references: [id])
  name                  String
  description           String
  isOperational         Boolean             @default(true)
  keyFocus              String?
}

model FundingSource {
  id          String   @id @default(uuid())
  name        String
  agencyType  String
  websiteUrl  String?
  description String?
  createdAt   DateTime @default(now())

  opportunities FundingOpportunity[]
}

model FundingOpportunity {
  id                           String            @id @default(uuid())
  fundingSourceId              String?
  fundingSource                FundingSource?    @relation(fields: [fundingSourceId], references: [id])
  title                        String
  fundingAgency                String
  isDemo                       Boolean           @default(false)
  sourceSystem                 String            @default("DEMO_FIXTURE")
  externalOpportunityId        String?
  fundingOpportunityNumber     String?
  sourceLastUpdatedTimestamp   DateTime?
  sourcePayloadHash            String?
  officialSourceAuthority      String?
  verificationStatus           String            @default("PENDING_HUMAN_REVIEW")
  program                      String?
  description                  String
  sourceUrl                    String
  status                       OpportunityStatus @default(PENDING_HUMAN_REVIEW)
  openingDate                  String            @default("UNKNOWN")
  deadline                     String            @default("UNKNOWN")
  awardMin                     String            @default("UNKNOWN")
  awardMax                     String            @default("UNKNOWN")
  totalAvailableFunding        String            @default("UNKNOWN")
  geography                    String            @default("UNKNOWN")
  eligibleApplicantTypes       String[]
  eligiblePopulations          String[]
  matchRequirement             String            @default("UNKNOWN")
  periodOfPerformance          String            @default("UNKNOWN")
  allowableCosts               String[]
  prohibitedCosts              String[]
  participantCompensationRules String?
  requiredPartnerships         String?
  operatingHistoryRequirements String?
  firstRetrievedAt             DateTime?
  lastRetrievedAt              DateTime?
  lastVerifiedTimestamp        DateTime?
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt

  // Participant Support Allowability Matrix
  supportTrainingStipends     TriStateStatus @default(UNKNOWN)
  supportNeedsRelatedPayments TriStateStatus @default(UNKNOWN)
  supportTransportation       TriStateStatus @default(UNKNOWN)
  supportMeals                TriStateStatus @default(UNKNOWN)
  supportChildcare            TriStateStatus @default(UNKNOWN)
  supportTools                TriStateStatus @default(UNKNOWN)
  supportPPE                  TriStateStatus @default(UNKNOWN)
  supportWorkClothing         TriStateStatus @default(UNKNOWN)
  supportLaptops              TriStateStatus @default(UNKNOWN)
  supportTrainingEquipment    TriStateStatus @default(UNKNOWN)
  supportCertifications       TriStateStatus @default(UNKNOWN)
  supportPaidWorkExperience   TriStateStatus @default(UNKNOWN)
  supportSubsidizedEmployment TriStateStatus @default(UNKNOWN)
  supportOnTheJobTraining     TriStateStatus @default(UNKNOWN)
  supportEmergencyAssistance  TriStateStatus @default(UNKNOWN)

  // Phase 1D Pursuit & Triage
  pursuitStage           PursuitStage            @default(NEW)
  candidateRoutingStatus CandidateRoutingStatus?
  dismissedReason        String?
  discoverySearchTerms   String[]                @default([])
  currentCycleStatus     String?                 @default("ACTIVE")
  hasSourceConflict      Boolean                 @default(false)

  // Relations
  eligibilityRequirements EligibilityRequirement[]
  allowableCostItems      AllowableCost[]
  requiredDocuments       RequiredDocument[]
  scoringCriteria         ScoringCriterion[]
  sourceCitations         SourceCitation[]
  opportunityAnalyses     OpportunityAnalysis[]
  snapshots               SourceSnapshot[]
  relevanceAnalyses       OpportunityRelevance[]
  pursuitHistory          PursuitHistory[]
  sponsorMatches          OpportunitySponsorMatch[]
  partnerMatches          OpportunityPartnerMatch[]
  readinessPlans          OpportunityReadinessPlan[]
  grantCalendarItems      GrantCalendarItem[]
  engagements             OutreachEngagement[]
  aiEvaluations           AiEvaluation[]
  recoveryRecords         FundingOpportunityRecoveryRecord[]
  fundingDocuments        FundingDocument[]

  @@unique([sourceSystem, externalOpportunityId])
  @@index([candidateRoutingStatus])
}

model EligibilityRequirement {
  id                   String             @id @default(uuid())
  fundingOpportunityId String
  fundingOpportunity   FundingOpportunity @relation(fields: [fundingOpportunityId], references: [id])
  criteriaCategory     String
  description          String
  isMandatory          Boolean            @default(true)
  verifiedStatus       TriStateStatus     @default(UNKNOWN)
  notes                String?
}

model AllowableCost {
  id                   String             @id @default(uuid())
  fundingOpportunityId String
  fundingOpportunity   FundingOpportunity @relation(fields: [fundingOpportunityId], references: [id])
  costCategory         String
  isAllowable          TriStateStatus     @default(UNKNOWN)
  restrictions         String?
  citationRefId        String?
}

model RequiredDocument {
  id                   String             @id @default(uuid())
  fundingOpportunityId String
  fundingOpportunity   FundingOpportunity @relation(fields: [fundingOpportunityId], references: [id])
  documentName         String
  description          String?
  isMandatory          Boolean            @default(true)
}

model ScoringCriterion {
  id                   String             @id @default(uuid())
  fundingOpportunityId String
  fundingOpportunity   FundingOpportunity @relation(fields: [fundingOpportunityId], references: [id])
  criterionName        String
  maxPoints            Int?
  description          String?
  evaluationFocus      String?
}

model SourceCitation {
  id                   String             @id @default(uuid())
  fundingOpportunityId String
  fundingOpportunity   FundingOpportunity @relation(fields: [fundingOpportunityId], references: [id])
  sourceUrl            String
  sourceTitle          String?
  sourceOrganization   String?
  verificationDate     DateTime           @default(now())
  quotedSection        String?
  extractedClaim       String

  eligibilityFindings        EligibilityFinding[]
  analysisDimensions         AnalysisDimension[]
  participantSupportFindings ParticipantSupportFinding[]
}

model OpportunityAnalysis {
  id                             String             @id @default(uuid())
  fundingOpportunityId           String
  fundingOpportunity             FundingOpportunity @relation(fields: [fundingOpportunityId], references: [id], onDelete: Cascade)
  analysisVersion                String             @default("1.0")
  sourceFingerprint              String
  profileVersion                 String             @default("1.1.0-phase1d")
  profileHash                    String
  profileSnapshot                Json
  eligibilityDecision            String             @default("INVESTIGATE") // ELIGIBLE, INVESTIGATE, NOT_ELIGIBLE
  recommendation                 String             @default("INVESTIGATE") // HIGH_PRIORITY, INVESTIGATE, FUTURE_OPPORTUNITY, NOT_ELIGIBLE
  overallFitScore                Int                @default(0) // 0 - 100
  evidenceCoverage               Int                @default(0) // 0 - 100
  eligibilityStatus              EligibilityStatus  @default(INVESTIGATE)
  missingEligibilityRequirements String[]
  missingCapabilities            String[]
  reasoningSummary               String             @default("Analysis pending.")

  // Dimensional Scores (0 - 100)
  missionAlignmentScore       Int @default(0)
  populationAlignmentScore    Int @default(0)
  programAlignmentScore       Int @default(0)
  geographicEligibilityScore  Int @default(0)
  applicantEligibilityScore   Int @default(0)
  taxStatusEligibilityScore   Int @default(0)
  organizationalMaturityScore Int @default(0)
  requiredPartnershipsScore   Int @default(0)
  allowableCostAlignmentScore Int @default(0)
  awardSizeSuitabilityScore   Int @default(0)
  deadlineFeasibilityScore    Int @default(0)
  evidenceTrackRecordScore    Int @default(0)

  // Governance & Review
  reviewStatus        String    @default("PENDING_HUMAN_REVIEW") // PENDING_HUMAN_REVIEW, HUMAN_REVIEWED
  reviewedAt          DateTime?
  reviewerId          String?
  reviewerNotes       String?
  isCurrent           Boolean   @default(true)
  humanReviewRequired Boolean   @default(true)
  humanReviewedAt     DateTime?
  humanReviewedBy     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Phase 1C Relations
  eligibilityFindings        EligibilityFinding[]
  analysisDimensions         AnalysisDimension[]
  participantSupportFindings ParticipantSupportFinding[]
  analysisReviews            AnalysisReview[]
}

model EligibilityFinding {
  id                    String              @id @default(uuid())
  opportunityAnalysisId String
  opportunityAnalysis   OpportunityAnalysis @relation(fields: [opportunityAnalysisId], references: [id], onDelete: Cascade)
  criterionKey          String
  criterionText         String
  outcome               String // SATISFIED, FAILED, UNKNOWN
  remediable            Boolean             @default(false)
  rationale             String
  evidenceStatus        String // EVIDENCE_PRESENT, MISSING_EVIDENCE
  sourceCitationId      String?
  sourceCitation        SourceCitation?     @relation(fields: [sourceCitationId], references: [id])
  evidenceQuote         String?
}

model AnalysisDimension {
  id                    String              @id @default(uuid())
  opportunityAnalysisId String
  opportunityAnalysis   OpportunityAnalysis @relation(fields: [opportunityAnalysisId], references: [id], onDelete: Cascade)
  dimensionKey          String
  weight                Int
  matchStatus           String // MATCH, PARTIAL, MISMATCH, UNKNOWN
  scoreAwarded          Int
  rationale             String
  evidenceStatus        String // EVIDENCE_PRESENT, MISSING_EVIDENCE
  sourceCitationId      String?
  sourceCitation        SourceCitation?     @relation(fields: [sourceCitationId], references: [id])
  evidenceQuote         String?

  @@unique([opportunityAnalysisId, dimensionKey])
}

model ParticipantSupportFinding {
  id                      String              @id @default(uuid())
  opportunityAnalysisId   String
  opportunityAnalysis     OpportunityAnalysis @relation(fields: [opportunityAnalysisId], references: [id], onDelete: Cascade)
  category                String
  automatedStatus         TriStateStatus      @default(UNKNOWN) // YES, NO, CONDITIONAL, UNKNOWN
  automatedRationale      String
  evidenceStatus          String // EVIDENCE_PRESENT, MISSING_EVIDENCE
  sourceCitationId        String?
  sourceCitation          SourceCitation?     @relation(fields: [sourceCitationId], references: [id])
  evidenceQuote           String?
  humanOverrideStatus     TriStateStatus?
  humanOverrideNotes      String?
  humanOverrideReviewerId String?
  humanOverrideAt         DateTime?

  @@unique([opportunityAnalysisId, category])
}

model AnalysisReview {
  id                    String              @id @default(uuid())
  opportunityAnalysisId String
  opportunityAnalysis   OpportunityAnalysis @relation(fields: [opportunityAnalysisId], references: [id], onDelete: Cascade)
  decision              String // APPROVED, REJECTED, FLAGGED
  reviewerId            String
  reviewerNotes         String
  reviewedAt            DateTime            @default(now())
}

model OpportunityRelevance {
  id                   String             @id @default(uuid())
  fundingOpportunityId String
  fundingOpportunity   FundingOpportunity @relation(fields: [fundingOpportunityId], references: [id], onDelete: Cascade)
  relevanceStatus      RelevanceStatus    @default(UNKNOWN)
  relevanceScore       Int                @default(0)
  positiveReasons      String[]
  exclusionReasons     String[]
  explanation          String
  evidenceFields       String[]
  analysisVersion      String             @default("1.0")
  profileVersion       String             @default("1.1.0-phase1d")
  profileHash          String
  isCurrent            Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  citations RelevanceCitation[]
}

model RelevanceCitation {
  id                     String               @id @default(uuid())
  opportunityRelevanceId String
  opportunityRelevance   OpportunityRelevance @relation(fields: [opportunityRelevanceId], references: [id], onDelete: Cascade)
  field                  String
  matchedTerm            String
  contextSnippet         String
}

model PursuitHistory {
  id                   String             @id @default(uuid())
  fundingOpportunityId String
  fundingOpportunity   FundingOpportunity @relation(fields: [fundingOpportunityId], references: [id], onDelete: Cascade)
  fromStage            PursuitStage
  toStage              PursuitStage
  actorId              String
  notes                String?
  reason               String?
  createdAt            DateTime           @default(now())
}

model IngestionRun {
  id                String    @id @default(uuid())
  sourceSystem      String    @default("GRANTS_GOV")
  searchParameters  Json
  startTime         DateTime  @default(now())
  completionTime    DateTime?
  status            String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, FAILED, PARTIAL_SUCCESS
  recordsDiscovered Int       @default(0)
  recordsCreated    Int       @default(0)
  recordsUpdated    Int       @default(0)
  recordsUnchanged  Int       @default(0)
  recordsFailed     Int       @default(0)
  errorSummary      String?
  createdAt         DateTime  @default(now())

  snapshots SourceSnapshot[]
}

model SourceSnapshot {
  id                    String              @id @default(uuid())
  ingestionRunId        String?
  ingestionRun          IngestionRun?       @relation(fields: [ingestionRunId], references: [id])
  fundingOpportunityId  String?
  fundingOpportunity    FundingOpportunity? @relation(fields: [fundingOpportunityId], references: [id])
  externalOpportunityId String
  retrievalTimestamp    DateTime            @default(now())
  payloadHash           String
  schemaVersion         String              @default("1.0")
  rawPayload            Json
}

// Phase 1E Enums
enum SponsorMatchStatus {
  RESEARCH_REQUIRED
  POSSIBLE_MATCH
  CONTACT_APPROVED
  CONTACTED
  DISCOVERY_CALL
  APPLICATION_SUBMITTED
  ACCEPTED
  DECLINED
  INACTIVE
}

enum PartnerMatchStatus {
  RESEARCH_REQUIRED
  POSSIBLE_MATCH
  CONTACT_APPROVED
  CONTACTED
  DISCOVERY_CALL
  PARTNERSHIP_DISCUSSION
  MOU_IN_PROGRESS
  CONFIRMED_PARTNER
  DECLINED
  INACTIVE
}

enum RecurrenceConfidence {
  CONFIRMED_FORECAST
  HISTORICALLY_RECURRING
  POSSIBLY_RECURRING
  ONE_TIME_OR_UNKNOWN
}

enum PlanTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum SponsorshipModel {
  MODEL_A
  MODEL_B
  MODEL_C
  MODEL_D
  MODEL_E
  MODEL_F
  ORGANIZATION_SPECIFIC
  UNKNOWN
}

// Phase 1E Models
model FiscalSponsorCandidate {
  id                     String    @id @default(uuid())
  name                   String
  websiteUrl             String
  directorySourceUrl     String
  geography              String
  mission                String
  populationsServed      String[]
  modelsOffered          String[]
  acceptingNewProjects   String    @default("UNKNOWN")
  applicationProcess     String    @default("UNKNOWN")
  estimatedReviewTime    String    @default("UNKNOWN")
  setupFee               String    @default("UNKNOWN")
  adminPercentage        String    @default("UNKNOWN")
  minRevenueRequirement  String    @default("UNKNOWN")
  administersGovGrants   String    @default("UNKNOWN")
  federalGrantCapability String    @default("UNKNOWN")
  samUeiStatus           String    @default("UNKNOWN")
  contactChannel         String    @default("UNKNOWN")
  verificationStatus     String    @default("PENDING_HUMAN_REVIEW")
  lastVerifiedTimestamp  DateTime?
  internalNotes          String?

  // Phase 1E Source Accuracy & Granular Verification
  isFixture           Boolean @default(false)
  hasLiveVerification Boolean @default(false)
  canonicalDomain     String  @default("")
  ein                 String?
  isMerged            Boolean @default(false)
  mergedIntoId        String?
  verificationLevel   String  @default("DIRECTORY_REPORTED")

  // Granular Evidence Coverage Metrics (0–100%)
  identityEvidenceCoverage         Int @default(0)
  operationalEvidenceCoverage      Int @default(0)
  opportunityCompatibilityCoverage Int @default(0)

  identityVerified                      String    @default("UNKNOWN")
  websiteVerified                       String    @default("UNKNOWN")
  intakeStatus                          String    @default("UNKNOWN")
  intakeStatusVerifiedAt                DateTime?
  sponsorshipModelsVerified             String    @default("UNKNOWN")
  governmentGrantAdministrationVerified String    @default("UNKNOWN")
  feeVerified                           String    @default("UNKNOWN")
  leadTimeVerified                      String    @default("UNKNOWN")
  opportunitySpecificCompatibility      String    @default("HUMAN_CONFIRMATION_REQUIRED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  citations          SponsorSourceCitation[]
  opportunityMatches OpportunitySponsorMatch[]

  @@index([canonicalDomain])
  @@index([isMerged])
}

model SponsorSourceCitation {
  id                       String                 @id @default(uuid())
  fiscalSponsorCandidateId String
  fiscalSponsorCandidate   FiscalSponsorCandidate @relation(fields: [fiscalSponsorCandidateId], references: [id], onDelete: Cascade)
  sourceUrl                String
  quotedSection            String?
  extractedClaim           String
  verificationLevel        String                 @default("DIRECTORY_REPORTED")
  fetchedAt                DateTime               @default(now())
  responseHash             String?
  verificationDate         DateTime               @default(now())
}

model SponsorDiscoveryQueryLog {
  id                     String   @id @default(uuid())
  sourceName             String
  sourceUrl              String
  requestedUrl           String   @default("")
  finalUrl               String   @default("")
  sourceType             String   @default("DIRECTORY_INDEX")
  requestAttempted       Boolean  @default(true)
  httpStatus             Int      @default(200)
  contentType            String?
  responseByteCount      Int      @default(0)
  pageTitle              String?
  fetchedAt              DateTime @default(now())
  responseHash           String
  fetchMode              String   @default("LIVE_HTTP")
  redirectsFollowed      Int      @default(0)
  fixtureFallbackUsed    Boolean  @default(false)
  sourceStatus           String   @default("SUCCESS")
  rejectionReason        String?
  transportError         String?
  candidatesParsed       Int      @default(0)
  candidatesAccepted     Int      @default(0)
  candidatesDeduplicated Int      @default(0)
  recordsRejected        Int      @default(0)
  rejectionReasons       String[] @default([])
  createdAt              DateTime @default(now())
}

model StrategicPartnerCandidate {
  id                              String             @id @default(uuid())
  name                            String
  legalOrganizationName           String             @default("UNKNOWN")
  organizationType                String
  websiteUrl                      String
  geography                       String
  countiesServed                  String[]           @default([])
  cocNumber                       String             @default("UNKNOWN")
  collaborativeApplicantOrg       String             @default("UNKNOWN")
  leadAgency                      String             @default("UNKNOWN")
  verifiedOfficialRole            String             @default("UNKNOWN")
  officialDirectoryUrl            String             @default("UNKNOWN")
  applicationCoordinatedEntryRole String             @default("UNKNOWN")
  currentCycleParticipationInfo   String             @default("UNKNOWN")
  mission                         String
  servicesOffered                 String[]
  collaborationFocus              String
  contactChannel                  String             @default("UNKNOWN")
  verificationStatus              String             @default("PENDING_HUMAN_REVIEW")
  isFixture                       Boolean            @default(false)
  hasLiveVerification             Boolean            @default(false)
  lastVerified                    DateTime?
  internalNotes                   String?
  status                          PartnerMatchStatus @default(RESEARCH_REQUIRED)
  createdAt                       DateTime           @default(now())
  updatedAt                       DateTime           @updatedAt

  citations          PartnerSourceCitation[]
  opportunityMatches OpportunityPartnerMatch[]
  contactChannels    PartnerContactChannel[]
  workflowHistory    PartnerWorkflowHistory[]
  engagements        OutreachEngagement[]
}

model PartnerContactChannel {
  id                          String                    @id @default(uuid())
  strategicPartnerCandidateId String
  strategicPartnerCandidate   StrategicPartnerCandidate @relation(fields: [strategicPartnerCandidateId], references: [id], onDelete: Cascade)
  contactValue                String
  contactType                 String                    @default("EMAIL")
  purpose                     String
  purposeCategory             String                    @default("GRANT_COMPETITION")
  sourceUrl                   String
  quotedCitation              String
  verifiedAt                  DateTime                  @default(now())
  verificationStatus          String                    @default("VERIFIED_HUMAN_REVIEWED")
  lastHttpStatus              Int?
  responseByteCount           Int?
  responseHash                String?
  verificationMode            String                    @default("LIVE_HTTP")
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt

  @@index([strategicPartnerCandidateId])
}

model PartnerWorkflowHistory {
  id                          String                    @id @default(uuid())
  strategicPartnerCandidateId String
  strategicPartnerCandidate   StrategicPartnerCandidate @relation(fields: [strategicPartnerCandidateId], references: [id], onDelete: Cascade)
  previousStage               PartnerMatchStatus
  newStage                    PartnerMatchStatus
  performedBy                 String                    @default("HUMAN_OPERATOR")
  reason                      String
  metadata                    Json?
  createdAt                   DateTime                  @default(now())

  @@index([strategicPartnerCandidateId])
}

model PartnerSourceCitation {
  id                          String                    @id @default(uuid())
  strategicPartnerCandidateId String
  strategicPartnerCandidate   StrategicPartnerCandidate @relation(fields: [strategicPartnerCandidateId], references: [id], onDelete: Cascade)
  sourceUrl                   String
  quotedSection               String?
  extractedClaim              String
  verificationLevel           String                    @default("OFFICIAL_DIRECTORY")
  fetchedAt                   DateTime                  @default(now())
}

model OpportunityPartnerMatch {
  id                          String                    @id @default(uuid())
  fundingOpportunityId        String
  fundingOpportunity          FundingOpportunity        @relation(fields: [fundingOpportunityId], references: [id], onDelete: Cascade)
  strategicPartnerCandidateId String
  strategicPartnerCandidate   StrategicPartnerCandidate @relation(fields: [strategicPartnerCandidateId], references: [id], onDelete: Cascade)
  matchScore                  Int                       @default(0)
  evidenceCoverage            Int                       @default(0)
  status                      PartnerMatchStatus        @default(POSSIBLE_MATCH)
  humanApproved               Boolean                   @default(false)
  alignmentRationale          String
  verifiedOfficialRole        String                    @default("UNKNOWN")
  countiesOverlap             String[]                  @default([])
  overlapCounties             String[]                  @default([])
  coverageScope               String                    @default("UNKNOWN")
  dimensionBreakdown          Json?
  concerns                    String[]                  @default([])
  missingInfo                 String[]                  @default([])
  recommendedNextStep         String                    @default("Review partnership potential")
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
}

model OpportunitySponsorMatch {
  id                        String                 @id @default(uuid())
  fundingOpportunityId      String
  fundingOpportunity        FundingOpportunity     @relation(fields: [fundingOpportunityId], references: [id], onDelete: Cascade)
  fiscalSponsorCandidateId  String
  fiscalSponsorCandidate    FiscalSponsorCandidate @relation(fields: [fiscalSponsorCandidateId], references: [id], onDelete: Cascade)
  matchScore                Int                    @default(0)
  evidenceCoverage          Int                    @default(0)
  matchedLanes              String[]
  status                    SponsorMatchStatus     @default(POSSIBLE_MATCH)
  humanApproved             Boolean                @default(false)
  alignmentRationale        String
  legalApplicantCapability  String
  govGrantAdminCapability   String
  arrangementAllowed        String
  feeAndLeadTimeNotes       String
  humanConfirmationRequired String[]
  concerns                  String[]
  missingInfo               String[]
  recommendedNextStep       String
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
}

model OpportunityReadinessPlan {
  id                                 String             @id @default(uuid())
  fundingOpportunityId               String
  fundingOpportunity                 FundingOpportunity @relation(fields: [fundingOpportunityId], references: [id], onDelete: Cascade)
  targetNextCycle                    String
  currentBlocker                     String
  requiredRegistrations              String[]
  fiscalSponsorOrPartnerRequirements String[]
  operatingHistoryAndCapacityGaps    String[]
  requiredDocuments                  String[]
  matchFundStrategy                  String
  responsibleOwner                   String             @default("Unassigned")
  targetCompletionDate               DateTime?
  isComplete                         Boolean            @default(false)
  createdAt                          DateTime           @default(now())
  updatedAt                          DateTime           @updatedAt

  tasks   ReadinessPlanTask[]
  history ReadinessPlanHistory[]
}

model ReadinessPlanTask {
  id               String                   @id @default(uuid())
  planId           String
  plan             OpportunityReadinessPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  title            String
  description      String
  category         String
  responsibleOwner String                   @default("Unassigned")
  targetDate       DateTime?
  status           PlanTaskStatus           @default(NOT_STARTED)
  sourceEvidence   String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
}

model ReadinessPlanHistory {
  id         String                   @id @default(uuid())
  planId     String
  plan       OpportunityReadinessPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  fromStatus String
  toStatus   String
  actorId    String
  notes      String?
  createdAt  DateTime                 @default(now())
}

model GrantCalendarItem {
  id                        String               @id @default(uuid())
  fundingOpportunityId      String?
  fundingOpportunity        FundingOpportunity?  @relation(fields: [fundingOpportunityId], references: [id])
  opportunityTitle          String
  agency                    String
  forecastedPostDate        DateTime?
  postedDate                DateTime?
  deadline                  DateTime?
  priorCycleDates           String[]
  recurrenceConfidence      RecurrenceConfidence @default(POSSIBLY_RECURRING)
  expectedNextCyclePrepDate DateTime?
  recurrenceEvidenceSource  String
  notes                     String?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
}

// --- Phase 1G: Human-Controlled Outreach & Response Tracking Models ---

model OutreachEngagement {
  id                          String                    @id @default(uuid())
  strategicPartnerCandidateId String
  strategicPartnerCandidate   StrategicPartnerCandidate @relation(fields: [strategicPartnerCandidateId], references: [id], onDelete: Cascade)
  fundingOpportunityId        String?
  fundingOpportunity          FundingOpportunity?       @relation(fields: [fundingOpportunityId], references: [id], onDelete: SetNull)
  opportunityPartnerMatchId   String?
  inquiryPurpose              String                    @default("GRANT_COMPETITION") // GRANT_COMPETITION, GOVERNANCE_MEMBERSHIP, CES_INTEGRATION, GENERAL
  currentStatus               PartnerMatchStatus        @default(RESEARCH_REQUIRED)
  dataOrigin                  String                    @default("OFFICIAL_LIVE") // OFFICIAL_LIVE, DEMO
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt

  draftVersions     OutreachDraftVersion[]
  evidenceSnapshots ContactEvidenceSnapshot[]
  humanApprovals    OutreachHumanApproval[]
  deliveryRecords   OutreachDeliveryRecord[]
  workflowHistory   OutreachWorkflowHistory[]
  responses         OutreachResponseRecord[]
  followUps         OutreachFollowUp[]
  discoveryCalls    OutreachDiscoveryCall[]
  mouChecklistItems MouChecklistItem[]
  attachmentRefs    OutreachAttachmentRef[]

  @@unique([strategicPartnerCandidateId, fundingOpportunityId, inquiryPurpose])
}

// --- Phase 1H: Closed Internal Authentication, RBAC, and Security Audit Models ---

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  displayName        String
  passwordHash       String
  role               String    @default("OPERATOR") // ADMIN, OPERATOR, VIEWER
  accountState       String    @default("ACTIVE") // ACTIVE, DISABLED
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  lastLoginAt        DateTime?

  sessions                 UserSession[]
  securityEvents           SecurityAuditEvent[]
  outreachDraftVersions    OutreachDraftVersion[]
  outreachHumanApprovals   OutreachHumanApproval[]
  outreachDeliveries       OutreachDeliveryRecord[]
  outreachHistories        OutreachWorkflowHistory[]
  outreachResponses        OutreachResponseRecord[]
  outreachFollowUps        OutreachFollowUp[]
  mouChecklistItems        MouChecklistItem[]
  generatedAiEvaluations   AiEvaluation[]            @relation("GeneratedAiEvaluations")
  reviewedAiEvaluations    AiEvaluation[]            @relation("ReviewedAiEvaluations")
  uploadedDocumentVersions FundingDocumentVersion[]  @relation("UploadedDocumentVersions")
}

model UserSession {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionHash String    @unique
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  lastSeenAt  DateTime  @default(now())
  revokedAt   DateTime?
}

model SecurityAuditEvent {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventType String // LOGIN_SUCCESS, LOGIN_FAILURE, LOGOUT, PASSWORD_CHANGE, USER_CREATION, ROLE_CHANGE, USER_STATE_CHANGE, SESSION_REVOCATION
  ipAddress String?
  userAgent String?
  details   String? // JSON string (NO secrets/passwords/tokens!)
  timestamp DateTime @default(now())

  classifications SecurityAuditEventClassification[]
}

model OutreachDraftVersion {
  id                     String             @id @default(uuid())
  engagementId           String
  engagement             OutreachEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  versionNumber          Int
  subject                String
  body                   String
  recipient              String
  inquiryPurpose         String
  creatorType            String             @default("AI_GENERATED") // AI_GENERATED, HUMAN_EDITED
  contentHash            String
  contactEvidenceRef     String?
  orgProfileVersion      String             @default("1.3.0-phase1f")
  orgProfileHash         String?
  opportunityAnalysisRef String?
  creatorActorName       String             @default("Thriveward Funding Intelligence Agent")
  creatorUserId          String?
  creatorUser            User?              @relation(fields: [creatorUserId], references: [id], onDelete: SetNull)
  createdAt              DateTime           @default(now())

  approvals OutreachHumanApproval[]
}

model ContactEvidenceSnapshot {
  id                 String             @id @default(uuid())
  engagementId       String
  engagement         OutreachEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  recipientEmail     String
  inquiryPurpose     String
  sourceUrl          String
  requestedUrl       String?
  finalUrl           String?
  httpStatus         Int?
  contentType        String?
  retrievedByteCount Int?
  retrievalTimestamp DateTime           @default(now())
  responseSha256     String?
  quotedCitation     String
  evidenceMode       String             @default("LIVE_HTTP")
  snapshotHash       String

  approvals OutreachHumanApproval[]
}

model OutreachHumanApproval {
  id                  String                   @id @default(uuid())
  engagementId        String
  engagement          OutreachEngagement       @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  draftVersionId      String
  draftVersion        OutreachDraftVersion     @relation(fields: [draftVersionId], references: [id], onDelete: Cascade)
  evidenceSnapshotId  String?
  evidenceSnapshot    ContactEvidenceSnapshot? @relation(fields: [evidenceSnapshotId], references: [id], onDelete: SetNull)
  humanReviewerName   String
  authenticatedUserId String?
  authenticatedUser   User?                    @relation(fields: [authenticatedUserId], references: [id], onDelete: SetNull)
  approvalTimestamp   DateTime                 @default(now())
  approvalReason      String
  approvedContentHash String
  zeroTransmissionAck Boolean                  @default(true)
}

model OutreachDeliveryRecord {
  id                     String             @id @default(uuid())
  engagementId           String
  engagement             OutreachEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  approvedDraftVersionId String?
  actualRecipient        String
  channel                String             @default("EMAIL")
  sentTimestamp          DateTime
  humanActorName         String
  authenticatedUserId    String?
  authenticatedUser      User?              @relation(fields: [authenticatedUserId], references: [id], onDelete: SetNull)
  exactSubject           String
  exactBodyHash          String
  notes                  String?
  idempotencyKey         String             @unique
  createdAt              DateTime           @default(now())

  responses OutreachResponseRecord[]
}

model OutreachWorkflowHistory {
  id                  String             @id @default(uuid())
  engagementId        String
  engagement          OutreachEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  previousStatus      String
  newStatus           String
  actorType           String             @default("HUMAN")
  humanActorName      String
  authenticatedUserId String?
  authenticatedUser   User?              @relation(fields: [authenticatedUserId], references: [id], onDelete: SetNull)
  actorRole           String?
  eventType           String             @default("WORKFLOW_TRANSITION")
  timestamp           DateTime           @default(now())
  reason              String
  relatedRecordId     String?
  eventHash           String
}

model OutreachResponseRecord {
  id                  String                  @id @default(uuid())
  engagementId        String
  engagement          OutreachEngagement      @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  deliveryRecordId    String?
  deliveryRecord      OutreachDeliveryRecord? @relation(fields: [deliveryRecordId], references: [id], onDelete: SetNull)
  receivedTimestamp   DateTime
  senderIdentity      String
  outcome             String // INTERESTED, NEEDS_MORE_INFORMATION, REFERRED_TO_ANOTHER_CONTACT, WRONG_CONTACT, FUTURE_CYCLE, DECLINED, NO_RESPONSE, OTHER
  summary             String
  quotedExcerpt       String?
  nextAction          String?
  humanRecorderName   String
  humanRecorderUserId String?
  humanRecorderUser   User?                   @relation(fields: [humanRecorderUserId], references: [id], onDelete: SetNull)
  idempotencyKey      String?                 @unique
  createdAt           DateTime                @default(now())
}

model OutreachFollowUp {
  id                  String             @id @default(uuid())
  engagementId        String
  engagement          OutreachEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  dueDateTime         DateTime
  timeZone            String             @default("America/Los_Angeles")
  reason              String
  status              String             @default("PENDING") // PENDING, COMPLETED, CANCELED, OVERDUE
  completedTimestamp  DateTime?
  notes               String?
  humanActorName      String
  authenticatedUserId String?
  authenticatedUser   User?              @relation(fields: [authenticatedUserId], references: [id], onDelete: SetNull)
  idempotencyKey      String?            @unique
  createdAt           DateTime           @default(now())
}

model OutreachDiscoveryCall {
  id                String             @id @default(uuid())
  engagementId      String
  engagement        OutreachEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  callState         String             @default("SCHEDULED") // SCHEDULED, COMPLETED
  callDateTime      DateTime
  timeZone          String             @default("America/Los_Angeles")
  participants      String[]           @default([])
  meetingMethod     String             @default("VIDEO_CONFERENCE")
  notes             String
  outcome           String
  nextAction        String
  humanRecorderName String
  createdAt         DateTime           @default(now())
}

model MouChecklistItem {
  id                  String             @id @default(uuid())
  engagementId        String
  engagement          OutreachEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  label               String
  status              String             @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED, WAITING_ON_PARTNER
  responsibleParty    String
  dueDate             DateTime?
  evidenceRef         String?
  completedTimestamp  DateTime?
  humanActorName      String
  authenticatedUserId String?
  authenticatedUser   User?              @relation(fields: [authenticatedUserId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())
}

model OutreachAttachmentRef {
  id           String             @id @default(uuid())
  engagementId String
  engagement   OutreachEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  filename     String
  mediaType    String
  byteSize     Int?
  sha256Hash   String?
  storageRef   String
  description  String?
  createdAt    DateTime           @default(now())
}

// --- AI-1: AI Funding Analyst Models & Enums ---

enum AiEvaluationStatus {
  GENERATED
  APPROVED
  REJECTED
}

enum AiEligibilityRating {
  LIKELY_ELIGIBLE
  POSSIBLY_ELIGIBLE
  UNLIKELY_ELIGIBLE
  INSUFFICIENT_INFORMATION
}

model AiEvaluation {
  id                    String              @id @default(uuid())
  opportunityId         String
  opportunity           FundingOpportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  version               Int                 @default(1)
  status                AiEvaluationStatus  @default(GENERATED)
  alignmentScore        Int
  eligibility           AiEligibilityRating
  summary               String
  strengths             Json
  risks                 Json
  requirements          Json
  recommendedNextAction String
  confidence            Float
  limitations           String[]
  evidenceSnapshot      Json
  inputSnapshot         Json
  inputHash             String
  provider              String              @default("OPENAI")
  model                 String              @default("gpt-5.6-luna")
  promptVersion         String              @default("funding-analyst-v1")
  idempotencyKey        String?
  providerResponseId    String?
  inputTokenCount       Int?
  outputTokenCount      Int?
  generatedByUserId     String
  generatedByUser       User                @relation("GeneratedAiEvaluations", fields: [generatedByUserId], references: [id])
  createdAt             DateTime            @default(now())
  reviewedByUserId      String?
  reviewedByUser        User?               @relation("ReviewedAiEvaluations", fields: [reviewedByUserId], references: [id])
  reviewedAt            DateTime?
  reviewReason          String?

  recoveryRecords AiEvaluationRecoveryRecord[]

  @@unique([generatedByUserId, opportunityId, idempotencyKey])
  @@index([opportunityId, version])
  @@index([generatedByUserId])
  @@index([status])
}

model SecurityAuditClassificationBatch {
  id              String                             @id @default(uuid())
  batchName       String
  reason          String
  eventCount      Int
  manifestDigest  String
  evidence        String?
  actorType       String                             @default("SYSTEM_DATA_REPAIR")
  createdAt       DateTime                           @default(now())
  classifications SecurityAuditEventClassification[]
}

model SecurityAuditEventClassification {
  id                    String                           @id @default(uuid())
  securityAuditEventId  String
  securityAuditEvent    SecurityAuditEvent               @relation(fields: [securityAuditEventId], references: [id], onDelete: Cascade)
  classificationBatchId String
  batch                 SecurityAuditClassificationBatch @relation(fields: [classificationBatchId], references: [id], onDelete: Cascade)
  classification        String
  reason                String
  createdAt             DateTime                         @default(now())

  @@unique([securityAuditEventId, classificationBatchId])
  @@index([securityAuditEventId])
  @@index([classificationBatchId])
}

model FundingOpportunityRecoveryRecord {
  id                       String             @id @default(uuid())
  originalOpportunityId    String
  currentOpportunityId     String
  currentOpportunity       FundingOpportunity @relation(fields: [currentOpportunityId], references: [id], onDelete: Cascade)
  fundingOpportunityNumber String
  recoveryReason           String
  recoveryMechanism        String
  sourceEvidence           String
  originalDeletedAt        DateTime?
  createdAt                DateTime           @default(now())
  actorType                String             @default("SYSTEM_DATA_REPAIR")

  @@index([currentOpportunityId])
  @@index([originalOpportunityId])
}

model AiEvaluationRecoveryRecord {
  id                     String       @id @default(uuid())
  aiEvaluationId         String
  aiEvaluation           AiEvaluation @relation(fields: [aiEvaluationId], references: [id], onDelete: Cascade)
  originalOpportunityId  String
  currentOpportunityId   String
  originalAuditEventId   String?
  inputHash              String
  providerResponseId     String?
  recoveryReason         String
  recoveryMechanism      String
  fieldEquivalenceResult String
  createdAt              DateTime     @default(now())
  actorType              String       @default("SYSTEM_DATA_REPAIR")

  @@index([aiEvaluationId])
  @@index([originalOpportunityId])
}

// --- AI-2A: Official Notice Ingestion & Citation Foundation Models ---

enum DocumentType {
  OFFICIAL_NOTICE
  AMENDMENT
  SUPPLEMENTAL
  OTHER_OFFICIAL_DOCUMENT
}

enum DocumentVersionStatus {
  UPLOADED
  PROCESSING
  READY
  OCR_REQUIRED
  FAILED
  SUPERSEDED
}

model FundingDocument {
  id                   String             @id @default(uuid())
  fundingOpportunityId String
  fundingOpportunity   FundingOpportunity @relation(fields: [fundingOpportunityId], references: [id], onDelete: Cascade)
  documentType         DocumentType       @default(OFFICIAL_NOTICE)
  title                String
  officialSourceUrl    String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  versions FundingDocumentVersion[]

  @@index([fundingOpportunityId])
}

model FundingDocumentVersion {
  id                String                @id @default(uuid())
  fundingDocumentId String
  fundingDocument   FundingDocument       @relation(fields: [fundingDocumentId], references: [id], onDelete: Cascade)
  version           Int
  status            DocumentVersionStatus @default(UPLOADED)
  originalFileName  String
  mimeType          String
  sizeBytes         Int
  sha256            String
  storageKey        String
  pageCount         Int                   @default(0)
  extractionVersion String                @default("pdf-page-text-v1")
  uploadedByUserId  String
  uploadedByUser    User                  @relation("UploadedDocumentVersions", fields: [uploadedByUserId], references: [id])
  createdAt         DateTime              @default(now())
  processedAt       DateTime?
  failureCode       String?
  failureMessage    String?

  pages FundingDocumentPage[]

  @@unique([fundingDocumentId, version])
  @@unique([fundingDocumentId, sha256])
  @@index([fundingDocumentId])
  @@index([uploadedByUserId])
  @@index([status])
}

model FundingDocumentPage {
  id                String                 @id @default(uuid())
  documentVersionId String
  documentVersion   FundingDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  pageNumber        Int
  text              String
  textHash          String
  characterCount    Int
  citationRef       String
  createdAt         DateTime               @default(now())

  @@unique([documentVersionId, pageNumber])
  @@index([documentVersionId])
  @@index([citationRef])
}
